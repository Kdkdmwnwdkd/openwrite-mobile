{
    "name": "openwrite-mobile",
    "version": "2.26.2",
    "description": "OpenWrite AI Novel Writing Assistant - Mobile Edition",
    "main": "index.js",
    "scripts": {
        "dev": "python3 -m http.server 8080 --directory frontend",
        "build": "npm run build:web && npm run build:capacitor",
        "build:web": "echo 'Web assets ready in frontend/'",
        "build:capacitor": "npx cap sync",
        "build:android": "npx cap build android",
        "build:ios": "npx cap build ios",
        "add:android": "npx cap add android",
        "add:ios": "npx cap add ios",
        "open:android": "npx cap open android",
        "open:ios": "npx cap open ios",
        "setup": "npm install && npm run setup:capacitor",
        "setup:capacitor": "npx cap init openwrite-mobile com.openwrite.mobile --web-dir frontend"
    },
    "dependencies": {
        "@capacitor/android": "^6.0.0",
        "@capacitor/app": "^6.0.3",
        "@capacitor/core": "^6.0.0",
        "@capacitor/filesystem": "^6.0.4",
        "@capacitor/ios": "^6.0.0",
        "@capacitor/share": "^6.0.4",
        "@capacitor/splash-screen": "^6.0.4",
        "@capacitor/status-bar": "^6.0.3"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.0.0"
    },
    "keywords": [
        "novel",
        "writing",
        "ai",
        "openwrite",
        "mobile",
        "app"
    ],
    "author": "OpenWrite Community",
    "license": "Apache-2.0"
}
