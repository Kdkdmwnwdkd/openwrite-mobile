{
    "appId": "com.openwrite.mobile",
    "appName": "OpenWrite",
    "webDir": "frontend",
    "server": {
        "androidScheme": "https",
        "cleartext": true
    },
    "plugins": {
        "SplashScreen": {
            "launchShowDuration": 2000,
            "launchAutoHide": true,
            "backgroundColor": "#6366f1",
            "androidSplashResourceName": "splash",
            "androidScaleType": "CENTER_CROP"
        },
        "StatusBar": {
            "style": "LIGHT",
            "backgroundColor": "#6366f1"
        }
    },
    "cordova": {}
}
